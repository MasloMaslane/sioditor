{
  "name": "sioditor",
  "private": true,
  "version": "0.0.0",
  "description": "Offline browser IDE with a real C++ and Python toolchain, for Polish OI practice",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @sioditor/web dev",
    "build": "pnpm --filter @sioditor/web build",
    "preview": "pnpm --filter @sioditor/web preview",
    "typecheck": "tsc --build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "vendor:pyodide": "node scripts/vendor-pyodide.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.62.1",
    "eslint": "^9.17.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  }
}
